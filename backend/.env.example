VERITEXT_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_HUB_DISABLE_XET=1
VERITEXT_ENABLE_SEMANTIC=true
VERITEXT_MAX_UPLOAD_MB=12
VERITEXT_MAX_TEXT_CHARS=200000
VERITEXT_MAX_REFERENCES=50
VERITEXT_MAX_TOTAL_REFERENCE_CHARS=2000000
VERITEXT_OCR_LANGUAGE=eng
VERITEXT_LEXICAL_THRESHOLD=0.28
VERITEXT_SEMANTIC_THRESHOLD=0.72
VERITEXT_CORS_ORIGINS=http://localhost:5173
